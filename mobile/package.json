{
  "name": "shomar-protect-mobile",
  "version": "0.2.1",
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.23",
    "expo-camera": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-image-picker": "~57.0.18",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.19",
    "expo-screen-capture": "~57.0.3",
    "expo-sharing": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "preview": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "export:native": "expo export --platform android --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm test && expo config --type public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "private": true
}
